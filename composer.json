{
  "name": "arraypress/wp-register-notices",
  "version": "1.0.0",
  "description": "A streamlined WordPress admin notices registration system with support for dismissible notices and error handling",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-register-notices/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\WP\\Register\\": "src/"
    },
    "files": [
      "src/Utilities.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-notices/issues",
    "source": "https://github.com/arraypress/wp-register-notices"
  },
  "keywords": [
    "wordpress",
    "admin-notices",
    "notifications",
    "wp-admin",
    "notices",
    "messages",
    "admin-messages",
    "wp-notifications",
    "dismissible-notices",
    "error-handling",
    "user-notifications"
  ]
}